# M1 validation configuration for the homeserver bench.
# Copy to e2e/m1/local.env and fill in your values. local.env is gitignored;
# API keys are never stored here — they are read from the server's config.xml
# files over SSH at runtime (or via KEY_<ROLE> overrides, see lib.mjs).

# --- Droparr deployment ---------------------------------------------------
# Where the deployed Droparr UI/API is reachable (LAN).
DROPARR_BASE_URL=http://192.0.2.10:3100
# SSH alias of the homeserver (must be non-interactive/key-based).
SSH_HOST=homeserver
# Repo clone on the server (deploy-server.sh keeps it up to date).
REMOTE_APP_DIR=/home/pat/homeserver/services/droparr/app
# Root of the *arr config dirs (config.xml lives at <root>/<container>/config/config.xml).
REMOTE_CONFIG_ROOT=/home/pat/homeserver-data
# LAN IP the Droparr UI is published on.
LAN_IP=192.0.2.10

# --- Server paths ---------------------------------------------------------
DATA_HOST_DIR=/home/pat/homeserver-data/droparr
# Shared staging: visible to Droparr (STAGING_APP) and the *arrs (STAGING_REMOTE).
STAGING_HOST_DIR=/mnt/SamsungSSD/Media/.droparr/staging
STAGING_APP=/data/staging
STAGING_REMOTE=/media-03/.droparr/staging
# Drop folder mounted into Droparr as /incoming.
DROPS_HOST_DIR=/mnt/SamsungSSD/Downloads/droparr-drops
DROPS_APP=/incoming
# Isolated root folders for validation imports (created by setup.mjs).
TEST_ROOT_HOST_DIR=/mnt/SamsungSSD/Media/DROPARR-TEST

# --- *arr instances -------------------------------------------------------
# <ROLE>_URL      — how the validation scripts reach the instance (Traefik/LAN)
# <ROLE>_INTERNAL — how Droparr reaches it (docker network, from its container)
# <ROLE>_ROOT     — test root folder as the instance sees it
# <ROLE>_PROFILE  — quality profile id
# <ROLE>_CONTAINER— config dir name for the API key (optional, defaults below)

SONARR_TV_URL=http://sonarr2.homeserver.local
SONARR_TV_INTERNAL=http://gluetun:8990
SONARR_TV_ROOT=/media-03/DROPARR-TEST/SERIES
SONARR_TV_PROFILE=4

SONARR_ANIME_URL=http://sonarr.homeserver.local
SONARR_ANIME_INTERNAL=http://gluetun:8989
SONARR_ANIME_ROOT=/media-03/DROPARR-TEST/ANIME
SONARR_ANIME_PROFILE=7

RADARR_MOVIES_URL=http://radarr2.homeserver.local
RADARR_MOVIES_INTERNAL=http://gluetun:7879
RADARR_MOVIES_ROOT=/media-03/DROPARR-TEST/MOVIES
RADARR_MOVIES_PROFILE=4

# Optional overrides (defaults shown):
# SONARR_TV_CONTAINER=sonarr2
# SONARR_ANIME_CONTAINER=sonarr
# RADARR_MOVIES_CONTAINER=radarr2
# SONARR_TV_NAME=TV Sonarr
# SONARR_ANIME_NAME=Anime Sonarr
# RADARR_MOVIES_NAME=Movies Radarr
# TV_CATEGORY_NAME=TV
# ANIME_CATEGORY_NAME=Anime
# MOVIES_CATEGORY_NAME=Movies
# KEY_SONARR_TV=...      # skip SSH key lookup entirely if you prefer
