# M2.4 tunnel verification configuration.
# Copy to e2e/m2.4/local.env and fill in. local.env is gitignored.

# Public HTTPS URL served by the Cloudflare Tunnel (see docs/DEPLOYMENT.md).
DROPARR_URL=https://droparr.example.com

# Optional: an account used for the authenticated checks (cookie flags,
# session IP, oversized-chunk 413). Any Droparr account works; a throwaway
# one is fine. Without it those checks are skipped.
DROPARR_USERNAME=
DROPARR_PASSWORD=

# Optional: Cloudflare Access service token, when Access protects the
# hostname. Create one under Zero Trust -> Access -> Service Auth.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# Optional: set to 1 to prove the login limiter keys on the real client IP.
# WARNING: this consumes this public IP's login budget (20 attempts / 15 min),
# so browser sign-ins from the same network are limited for up to 15 minutes.
RATE_LIMIT_CHECK=0
